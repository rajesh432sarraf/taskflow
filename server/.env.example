# TaskFlow Server Environment Configuration (Example)
# Copy this file to .env and replace placeholders with actual values

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/taskflow?retryWrites=true&w=majority

# JWT Signing Secret (minimum 32 characters recommended)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

